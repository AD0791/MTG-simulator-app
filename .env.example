# Copy to .env for local development. Every setting the app reads is listed here.

# Identifier used in the OpenAPI title and logs.
APP_NAME=martingale-wall-simulator

# One of: CRITICAL, ERROR, WARNING, INFO, DEBUG.
LOG_LEVEL=INFO

# SQLite for the prototype. Production moves to, e.g.:
#   postgresql+psycopg://user:password@host:5432/mtg_simulator
#   mysql+pymysql://user:password@host:3306/mtg_simulator
DATABASE_URL=sqlite:///./app.db
